{
  "name": "tree-sitter-opencl",
  "version": "0.0.1",
  "description": "OpenCL C grammar for tree-sitter",
  "main": "bindings/node",
  "repository": {
    "type": "git",
    "url": "https://github.com/da2ce7/tree-sitter-opencl.git"
  },
  "homepage": "https://github.com/da2ce7/tree-sitter-opencl#readme",
  "bugs": {
    "url": "https://github.com/da2ce7/tree-sitter-opencl/issues"
  },
  "keywords": [
    "tree-sitter",
    "parser",
    "opencl",
    "grammar"
  ],
  "license": "MIT",
  "scripts": {
    "generate": "tree-sitter generate",
    "parse": "tree-sitter parse",
    "test": "tree-sitter test"
  },
  "dependencies": {
    "nan": "^2.17.0"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.20.8"
  },
  "tree-sitter": [
    {
      "scope": "source.cl",
      "file-types": [
        "cl"
      ],
      "highlights": "queries/highlights.scm"
    }
  ],
  "files": [
    "grammar.js",
    "binding.gyp",
    "bindings/node/*",
    "queries/*",
    "src/**"
  ]
}
