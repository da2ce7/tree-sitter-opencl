root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.js]
indent_style = space
indent_size = 2

[*.{rs,toml}]
indent_style = space
indent_size = 4

[*.scm]
indent_style = space
indent_size = 2

[*.{json,gyp}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
